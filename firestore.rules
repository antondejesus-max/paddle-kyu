rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for PaddleKyu Pickleball Ladder Queue Manager
    // Allows court-side read/write access for players, meetups, courts, queues, and matches
    match /players/{playerId} {
      allow read, write: if true;
    }
    
    match /meetups/{meetupId} {
      allow read, write: if true;
      
      match /roster/{playerId} {
        allow read, write: if true;
      }
      
      match /courts/{courtId} {
        allow read, write: if true;
      }
      
      match /matches/{matchId} {
        allow read, write: if true;
      }
    }
  }
}
